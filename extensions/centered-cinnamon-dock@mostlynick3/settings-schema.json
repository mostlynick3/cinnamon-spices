{
    "appearance-header": {
        "type": "header",
        "description": "Appearance"
    },
    "transparency": {
        "type": "spinbutton",
        "default": 85,
        "min": 0,
        "max": 100,
        "step": 5,
        "units": "percent",
        "description": "Transparency"
    },
    "zoom-enabled": {
        "type": "checkbox",
        "default": true,
        "description": "Enable zoom effect on hover"
    },
    "zoom-factor": {
        "type": "scale",
        "default": 1.3,
        "min": 1.0,
        "max": 2.0,
        "step": 0.1,
        "description": "Zoom scale factor"
    },
    "position-header": {
        "type": "header",
        "description": "Position and Layout"
    },
    "height-offset": {
        "type": "spinbutton",
        "default": -8,
        "min": -500,
        "max": 500,
        "step": 1,
        "units": "pixels",
        "description": "Height offset (negative = up, positive = down)"
    },
	"panel-mode": {
		"type": "combobox",
		"default": "main",
		"options": {
			"Main panel only": "main",
			"All bottom panels": "bottom",
			"All top panels": "top",
			"Top and bottom panels": "both",
			"Custom selection": "custom-selection"
		},
		"description": "Which panels to apply extension to"
	},
	"enabled-panels": {
		"type": "entry",
		"default": "",
		"dependency": "panel-mode=custom-selection",
		"description": "Panel IDs to enable (comma-separated, e.g., monitor0_bottom,monitor1_top). Leave empty when not in custom mode."
	},
    "no-window-shift": {
        "type": "checkbox",
        "default": true,
        "description": "Don't shift windows (disable panel struts)"
    },
    "autohide-header": {
        "type": "header",
        "description": "Auto-hide Behavior"
    },
    "auto-hide": {
        "type": "checkbox",
        "default": false,
        "description": "Auto-hide dock when focusing apps"
    },
    "show-on-no-focus": {
        "type": "checkbox",
        "default": true,
		"dependency": "auto-hide",
        "description": "Show dock when no window is focused"
    },
	"hide-delay": {
		"type": "spinbutton",
		"default": 500,
		"min": 0,
		"max": 5000,
		"step": 100,
		"units": "milliseconds",
		"dependency": "auto-hide",
		"description": "Delay before auto-hiding after showing dock"
	},
    "hover-pixels": {
        "type": "spinbutton",
        "default": 8,
        "min": 1,
        "max": 100,
        "step": 1,
        "units": "pixels",
		"dependency": "auto-hide",
        "description": "Height of trigger zone to show panel if hidden"
    },
    "show-indicator": {
        "type": "checkbox",
        "default": true,
		"dependency": "auto-hide",
        "description": "Show indicator of dock location in trigger zone"
    },
    "animation-time": {
        "type": "spinbutton",
        "default": 200,
        "min": 0,
        "max": 1000,
        "step": 50,
        "units": "milliseconds",
        "description": "Fade animation duration"
    }
}